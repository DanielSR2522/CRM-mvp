# ---------------------------------------------------------------------------
# SmarTrack CRM — Environment Configuration Template
# Copy this file to .env.local and fill in the values for your environment.
# Never commit real secrets, API keys, or tokens to source control.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

HEALTH_DATA_ENCRYPTION_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
PAYMENT_DATA_ENCRYPTION_KEY=

RESEND_API_KEY=
CRON_SECRET=
POLICY_REMINDER_FROM_EMAIL=
POLICY_REMINDER_FROM_NAME=
APP_BASE_URL=
POLICY_REMINDER_TEST_EMAIL=

# ---------------------------------------------------------------------------
# WhatsApp Cloud API (Meta)
# ---------------------------------------------------------------------------
# Used by:
#   src/app/api/signature-requests/[requestId]/send-whatsapp/route.ts
#   src/app/api/webhooks/whatsapp/route.ts
#   src/app/api/whatsapp/webhook/route.ts
#   src/lib/whatsapp/cloud-api.ts

# Permanent system user access token from Meta Business Manager.
WHATSAPP_ACCESS_TOKEN=

# WhatsApp Business Phone Number ID shown in Meta API setup page.
WHATSAPP_PHONE_NUMBER_ID=

# WhatsApp Business Account ID (WABA ID).
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Graph API version (required, e.g. v20.0 — no silent fallback).
WHATSAPP_API_VERSION=v20.0

# App Secret from Meta App Dashboard (App Settings -> Basic).
# Required for verifying incoming webhook X-Hub-Signature-256 signatures.
WHATSAPP_APP_SECRET=

# Custom verification token string entered in Meta Webhook config.
# Used to verify GET hub.verify_token requests.
WHATSAPP_VERIFY_TOKEN=

# Template names (default approved consent templates in Meta):
WHATSAPP_TEMPLATE_ES=health_consent_signature_request
WHATSAPP_TEMPLATE_ES_LANGUAGE=es_CO

WHATSAPP_TEMPLATE_EN=health_consent_ingles
WHATSAPP_TEMPLATE_EN_LANGUAGE=en
